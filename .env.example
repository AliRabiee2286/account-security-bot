# Copy to .env. Never commit real values.
APP_ENV=dev                      # dev | staging | prod
LOG_LEVEL=INFO
# Runtime uses the least-privileged application login; migrations use the admin login.
DATABASE_URL=postgresql+asyncpg://sentinel_app:CHANGE_ME@db:5432/sentinel
MIGRATION_DATABASE_URL=postgresql+asyncpg://sentinel_admin:CHANGE_ME@db:5432/sentinel
POSTGRES_PASSWORD=CHANGE_ME
SENTINEL_APP_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
REDIS_URL=redis://:CHANGE_ME@redis:6379/0
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=         # 32+ random chars; Telegram sends it in X-Telegram-Bot-Api-Secret-Token
PUBLIC_BASE_URL=https://bot.example.com
# KeyProvider (S-004). local = master key file mounted read-only, never on the DB host.
KEY_PROVIDER=local
MASTER_KEY_FILE=/run/secrets/master_key
SENTRY_DSN=
# Feature flags per module (D-009 rule 7)
MODULE_MAILBOXES_ENABLED=false
MODULE_SOCIAL_ENABLED=false
MODULE_INCIDENTS_ENABLED=false
